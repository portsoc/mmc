{
  "rules": {
    "sessions": {
      "$canvasId": {
        "updates": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "awareness": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
